+- (UISceneConfiguration *)application:(UIApplication *)application
+          configurationForConnectingSceneSession:(UISceneSession *)connectingSceneSession
+                                    options:(UISceneConnectionOptions *)options API_AVAILABLE(ios(13.0))
+{
+    /* UIKit uses the presence of this method to detect UIScene lifecycle support. */
+    /* This configuration is created in code, not loaded from an application's
+     * Info.plist. Match the connecting session's role explicitly; plain init
+     * produces UISceneSessionRoleNone and UIKit rejects that mismatch. */
+    UISceneConfiguration *config = [[UISceneConfiguration alloc] initWithName:nil
+                                                                  sessionRole:connectingSceneSession.role];
+    config.delegateClass = [SDLUIKitSceneDelegate class];
+    return config;
+}
