+static UIWindowScene *UIKit_GetWindowSceneForScreen(UIScreen *uiscreen)
+{
+    NSSet<UIScene *> *connectedScenes = [UIApplication sharedApplication].connectedScenes;
+    UIWindowScene *fallback = nil;
+
+    /* Prefer the active scene associated with this screen, then an inactive
+     * foreground scene. The fallback covers the short connection interval
+     * before UIKit marks the scene foreground-active. */
+    for (UIScene *scene in connectedScenes) {
+        UIWindowScene *windowScene;
+
+        if (![scene isKindOfClass:[UIWindowScene class]]) {
+            continue;
+        }
+
+        windowScene = (UIWindowScene *)scene;
+        if (windowScene.screen != uiscreen) {
+            continue;
+        }
+
+        if (windowScene.activationState == UISceneActivationStateForegroundActive) {
+            return windowScene;
+        }
+        if (windowScene.activationState == UISceneActivationStateForegroundInactive) {
+            fallback = windowScene;
+        } else if (fallback == nil) {
+            fallback = windowScene;
+        }
+    }
+
+    return fallback;
+}
