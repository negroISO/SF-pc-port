{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 / Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "SF_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-psycross",
      "displayName": "Windows x64 / Visual Studio 2026 / PsyCross",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build/windows-psycross",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "SF_ENABLE_PSYCROSS": "ON"
      }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "SF_BUILD_TESTS": "OFF",
        "SF_BUILD_ROM_PROBES": "OFF",
        "SF_ENABLE_PSYCROSS": "OFF",
        "SF_BUILD_IOS_SHELL": "ON",
        "SF_IOS_CODE_SIGNING": "OFF",
        "SF_ENABLE_RELEASE_IPO": "OFF",
        "SF_WARNINGS_AS_ERRORS": "OFF",
        "CMAKE_XCODE_ATTRIBUTE_CACHE_ROOT": "${sourceDir}/out/xcode-cache",
        "CMAKE_XCODE_ATTRIBUTE_CLANG_MODULE_CACHE_PATH": "${sourceDir}/out/xcode-cache/ModuleCache.noindex",
        "CMAKE_XCODE_ATTRIBUTE_CLANG_MODULES_BUILD_SESSION_FILE": "${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "CMAKE_XCODE_ATTRIBUTE_COMPILATION_CACHE_CAS_PATH": "${sourceDir}/out/xcode-cache/CompilationCache.noindex",
        "CMAKE_XCODE_ATTRIBUTE_COMPILER_INDEX_STORE_ENABLE": "NO",
        "CMAKE_XCODE_ATTRIBUTE_DSTROOT": "${sourceDir}/out/xcode-dst",
        "CMAKE_XCODE_ATTRIBUTE_SDK_STAT_CACHE_ENABLE": "NO"
      }
    },
    {
      "name": "ios-device",
      "displayName": "iOS device arm64 / bootstrap shell",
      "inherits": "ios-base",
      "binaryDir": "${sourceDir}/out/ios-device",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS Simulator arm64 / bootstrap shell",
      "inherits": "ios-base",
      "binaryDir": "${sourceDir}/out/ios-simulator",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },
    {
      "name": "ios-device-renderer-smoke",
      "displayName": "iOS device arm64 / ROM-free PsyCross renderer smoke",
      "inherits": "ios-base",
      "binaryDir": "${sourceDir}/out/ios-device-renderer-smoke",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "SF_BUILD_IOS_SHELL": "OFF",
        "SF_BUILD_IOS_RENDERER_SMOKE": "ON",
        "SF_IOS_DEPS_PREFIX": "${sourceDir}/out/ios-deps/install/iphoneos"
      }
    },
    {
      "name": "ios-simulator-renderer-smoke",
      "displayName": "iOS Simulator arm64 / ROM-free PsyCross renderer smoke",
      "inherits": "ios-base",
      "binaryDir": "${sourceDir}/out/ios-simulator-renderer-smoke",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "SF_BUILD_IOS_SHELL": "OFF",
        "SF_BUILD_IOS_RENDERER_SMOKE": "ON",
        "SF_IOS_DEPS_PREFIX": "${sourceDir}/out/ios-deps/install/iphonesimulator"
      }
    },
    {
      "name": "ios-device-guest-renderer-smoke",
      "displayName": "iOS device arm64 / bounded guest renderer smoke",
      "inherits": "ios-base",
      "binaryDir": "${sourceDir}/out/ios-device-guest-renderer-smoke",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "SF_BUILD_IOS_SHELL": "OFF",
        "SF_ENABLE_PSYCROSS": "ON",
        "SF_BUILD_IOS_GUEST_RENDERER_SMOKE": "ON",
        "SF_IOS_DEPS_PREFIX": "${sourceDir}/out/ios-deps/install/iphoneos"
      }
    },
    {
      "name": "ios-simulator-guest-renderer-smoke",
      "displayName": "iOS Simulator arm64 / bounded guest renderer smoke",
      "inherits": "ios-base",
      "binaryDir": "${sourceDir}/out/ios-simulator-guest-renderer-smoke",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "SF_BUILD_IOS_SHELL": "OFF",
        "SF_ENABLE_PSYCROSS": "ON",
        "SF_BUILD_IOS_GUEST_RENDERER_SMOKE": "ON",
        "SF_IOS_DEPS_PREFIX": "${sourceDir}/out/ios-deps/install/iphonesimulator"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-psycross-release",
      "configurePreset": "windows-psycross",
      "configuration": "Release"
    },
    {
      "name": "windows-core-release",
      "displayName": "Windows Release / core game only",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "targets": ["sf_game"]
    },
    {
      "name": "windows-psycross-app-release",
      "displayName": "Windows Release / playable app only",
      "configurePreset": "windows-psycross",
      "configuration": "Release",
      "targets": ["syphon_filter"]
    },
    {
      "name": "ios-device-core-release",
      "displayName": "iOS device Release / core game only",
      "configurePreset": "ios-device",
      "configuration": "Release",
      "targets": ["sf_game"],
      "nativeToolOptions": [
        "CLANG_MODULES_BUILD_SESSION_FILE=${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "SDK_STAT_CACHE_ENABLE=NO"
      ]
    },
    {
      "name": "ios-device-shell-release",
      "displayName": "iOS device Release / unsigned bootstrap shell",
      "configurePreset": "ios-device",
      "configuration": "Release",
      "targets": ["sf_ios"],
      "nativeToolOptions": [
        "CLANG_MODULES_BUILD_SESSION_FILE=${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "SDK_STAT_CACHE_ENABLE=NO"
      ]
    },
    {
      "name": "ios-simulator-shell-debug",
      "displayName": "iOS Simulator Debug / bootstrap shell",
      "configurePreset": "ios-simulator",
      "configuration": "Debug",
      "targets": ["sf_ios"],
      "nativeToolOptions": [
        "CLANG_MODULES_BUILD_SESSION_FILE=${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "SDK_STAT_CACHE_ENABLE=NO"
      ]
    },
    {
      "name": "ios-device-renderer-smoke-release",
      "displayName": "iOS device Release / ROM-free PsyCross renderer smoke",
      "configurePreset": "ios-device-renderer-smoke",
      "configuration": "Release",
      "targets": ["sf_ios_renderer_smoke"],
      "nativeToolOptions": [
        "CLANG_MODULES_BUILD_SESSION_FILE=${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "SDK_STAT_CACHE_ENABLE=NO"
      ]
    },
    {
      "name": "ios-simulator-renderer-smoke-release",
      "displayName": "iOS Simulator Release / ROM-free PsyCross renderer smoke",
      "configurePreset": "ios-simulator-renderer-smoke",
      "configuration": "Release",
      "targets": ["sf_ios_renderer_smoke"],
      "nativeToolOptions": [
        "CLANG_MODULES_BUILD_SESSION_FILE=${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "SDK_STAT_CACHE_ENABLE=NO"
      ]
    },
    {
      "name": "ios-device-guest-renderer-smoke-release",
      "displayName": "iOS device Release / bounded guest renderer smoke",
      "configurePreset": "ios-device-guest-renderer-smoke",
      "configuration": "Release",
      "targets": ["sf_ios_guest_renderer_smoke"],
      "nativeToolOptions": [
        "CLANG_MODULES_BUILD_SESSION_FILE=${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "SDK_STAT_CACHE_ENABLE=NO"
      ]
    },
    {
      "name": "ios-simulator-guest-renderer-smoke-release",
      "displayName": "iOS Simulator Release / bounded guest renderer smoke",
      "configurePreset": "ios-simulator-guest-renderer-smoke",
      "configuration": "Release",
      "targets": ["sf_ios_guest_renderer_smoke"],
      "nativeToolOptions": [
        "CLANG_MODULES_BUILD_SESSION_FILE=${sourceDir}/out/xcode-cache/ModuleCache.noindex/Session.modulevalidation",
        "SDK_STAT_CACHE_ENABLE=NO"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-psycross-release",
      "configurePreset": "windows-psycross",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
